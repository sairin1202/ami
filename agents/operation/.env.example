# 复制成 .env 后填写（./run.sh 读它）；~/.computer-use/.env 只补这里没有的项
OPENAI_API_KEY=sk-...
# 用第三方中转（如 nevatoken）时填它的地址和模型名，例如：
# OPENAI_BASE_URL=https://nevatoken.com/v1
# OPENAI_MODEL=MaaS_GP_6_luna_20260922    # nevatoken 上的 gpt-6-luna；gpt-6.1-sol 是 MaaS_GP_6.1_sol_20260929

# Jev 加速（可选）：TypeSafe 的 Jev 根据辅助功能控件表快速选操作，卡住时交回上面的模型
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# JEV_MIN_CONFIDENCE=0.6   # 低于这个置信度就交给 GPT
# JEV_TEXT_MODEL=           # 生成输入框文字用的模型，默认同 OPENAI_MODEL

# Exa 网页搜索（可选）：https://dashboard.exa.ai/api-keys ，没配时不提供网页搜索工具
# EXA_API_KEY=

# V2EX 个人访问令牌（可选，https://www.v2ex.com/settings/tokens 生成）：配了才能读自己的提醒、翻页看节点主题
# V2EX_TOKEN=
# GitHub 用本机已登录的 gh 命令行，不需要在这里配

# Discord / Slack / Telegram 机器人（可选；不填就不提供对应工具）
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# 飞书 / Lark（可选）：开放平台自建应用的凭证，用机器人身份读文档、读群消息、发消息
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=
# FEISHU_DOMAIN=lark          # lark = open.larksuite.com（国际版，默认）；feishu = open.feishu.cn（国内版）

# 模型请求超时 / 重试次数、截图缩放（可选）
# MODEL_TIMEOUT=60
# MODEL_RETRIES=1
# IMAGE_SCALE=0.7
# MINIMIZE_AFTER_RUN=on   # 每次运行结束后把用过的应用 / 浏览器窗口最小化

# 梗图（可选）：自己的梗图目录（默认 ~/.computer-use/memes），Jev 判断「要配」的概率至少多少才配
# MEMES_DIR=
# JEV_MEME_MIN_CONFIDENCE=0.5
# 挑梗图用的 Jev：配了 TYPESAFE_API_KEY 就用它，否则 OPENAI_BASE_URL 是 nevatoken 时用 nevatoken 转发的 Jev

# 助理人设（可选）：默认读仓库里的 SOUL.md；填文件路径换人设，填 off 关闭
# COMPUTER_USE_SOUL=

# 常驻工作流（可选）：off 不启动后台消息巡检；用户多久没动键鼠才在后台跑定时巡检；多久看一次菜单栏图标
# WORKFLOWS=on
# WORKFLOW_IDLE_SECONDS=60
# WORKFLOW_ICON_SECONDS=3

# 上报每一步的状态到 AMI 中控（可选）：有 key 才发，否则只存在本地待发队列；off 不记录也不发
# AMIENTS=on
# AMIENTS_URL=https://amients.com
# AMIENTS_API_KEY=ami_...
# 有 key 时后台工作流「领中控任务」会去中控领派给这个 agent 的任务，和消息巡检轮流做；off 只上报、不领任务
# AMIENTS_TASKS=on
# 只领注册过的能力（computer.do / message.send / message.inbox / post.draft / web.research）和自检；all 什么类型都领
# AMIENTS_TASK_KINDS=
# 自检时在浏览器里看哪些网站（逗号分隔，off 不碰浏览器），默认全部
# CHECKUP_SITES=

# 本地数据目录和经验记忆（可选）
# COMPUTER_USE_HOME=~/.computer-use
# COMPUTER_USE_MEMORY=on
# COMPUTER_USE_MESSAGES=on   # off：不把读到 / 发出的消息存到 ~/.computer-use/messages.db
# HISTORY_SUMMARY_CHARS=150000
